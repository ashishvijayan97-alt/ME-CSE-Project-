# Flask Application Configuration
SECRET_KEY=shopcloud-secret-key-production-2026-change-me
FLASK_DEBUG=True
PORT=3000

# Database Configuration (PostgreSQL for production, or SQLite fallback)
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/shopcloud_db
# SQLite fallback (default if DATABASE_URL is not set):
DATABASE_URL=sqlite:///shopcloud.db
